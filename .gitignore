# Node dependencies
node_modules/
**/node_modules/

# Build artifacts
dist/
**/dist/
dist-ssr/
**/dist-ssr/

# Environment files
*.local
.env
.env.*

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*

# OS and Editor files
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

# Video portfolio media rules (Original uncompressed media ignored)
*.mp4
*.mov
video/public/hero-video.mp4
video/public/Video portfolio/
**/Video portfolio/

# Explicit exceptions for web-optimized production video assets
!video/public/hero-stream.mp4
!video/public/hero-poster.webp
!video/public/posters/
!video/public/posters/**

# Graphic portfolio original source media (safely backed up in portfolio_media_backup/)
graphic/public/Graphic portfolio/*.*
graphic/public/Graphic portfolio/cafe/*.*
graphic/public/Graphic portfolio/east eyes/*.*
graphic/public/Graphic portfolio/gym/*.*

# Explicit exceptions for web-optimized graphic assets & essential files
!graphic/public/Graphic portfolio/thumbs/
!graphic/public/Graphic portfolio/thumbs/**
!graphic/public/Graphic portfolio/optimized/
!graphic/public/Graphic portfolio/optimized/**
!graphic/public/RW.png
!graphic/public/favicon.ico
!graphic/public/.htaccess

# Local assistant config
GEMINI.md

# Media source backup (Never push original uncompressed media to GitHub)
/portfolio_media_backup/
