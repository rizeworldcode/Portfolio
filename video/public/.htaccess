<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Handle Authorization Header
  RewriteCond %{HTTP:Authorization} .
  RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

  # If the requested file or directory exists, serve it directly
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Otherwise redirect all requests to index.html for SPA routing
  RewriteRule ^ index.html [L]
</IfModule>

# Enable Range Requests & MIME Types for Video Streaming
<IfModule mod_mime.c>
  AddType video/mp4 .mp4
  AddType video/webm .webm
  AddType video/quicktime .mov
  AddType image/webp .webp
</IfModule>

# Browser Caching & Performance Headers
<IfModule mod_expires.c>
  ExpiresActive On

  # HTML: Never cache index.html (Ensures immediate update detection on fresh deploys)
  ExpiresByType text/html "access plus 0 seconds"

  # Versioned Hashed Assets (Vite produces unique content hashes: index-BPkzBklZ.css)
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"

  # Media Assets
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType image/x-icon "access plus 1 month"
  ExpiresByType video/mp4 "access plus 1 month"
</IfModule>

<IfModule mod_headers.c>
  # 1-Year Immutable Cache for Vite Bundled Hashed JS & CSS
  <FilesMatch "\.(js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # 30-Day Cache for Posters and Videos
  <FilesMatch "\.(webp|jpg|jpeg|png|gif|svg|ico|mp4)$">
    Header set Cache-Control "public, max-age=2592000, stale-while-revalidate=86400"
  </FilesMatch>

  # Ensure index.html is revalidated immediately
  <FilesMatch "^(index\.html)?$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>

  # Security Header
  Header set X-Content-Type-Options "nosniff"
</IfModule>

# Gzip Compression for Fast Loading
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>

Options -Indexes
